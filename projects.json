{
  "owner": "newYurk",
  "site": "branches",
  "base": "/branches",
  "blockHosts": [],
  "projects": [
    {
      "repo": "temari",
      "title": "Темари",
      "tagline": "нить на сфере",
      "build": {
        "install": ["npm ci --no-audit --no-fund"],
        "gate": ["npm test", "npm run typecheck", "node scripts/sync-design.mjs --check"],
        "run": ["npm run build"],
        "out": "dist"
      },
      "entries": [
        { "path": "", "label": "мастерская" },
        { "path": "lab.html", "label": "лаборатория" },
        { "path": "design.html", "label": "как устроено" }
      ],
      "quiet": ["**/*.md", "docs/**", "reviews/**", "spec/**", ".github/**", ".claude/**"]
    },
    {
      "repo": "rollery",
      "title": "Ролльня",
      "tagline": "лист → спираль → срез",
      "build": { "copy": true },
      "entries": [
        { "path": "play/", "label": "играть" },
        { "path": "play/core-v2/", "label": "срез V2" },
        { "path": "", "label": "прихожая" },
        { "path": "docs/", "label": "документы" }
      ],
      "quiet": ["**/*.md", "sim/**", "tools/**", ".github/**", ".claude/**", ".gitignore"]
    },
    {
      "repo": "roti-stand",
      "title": "Ротишница",
      "tagline": "стойка роти",
      "build": { "copy": true },
      "entries": [
        { "path": "prototype/dough-closeup/", "label": "стенд теста" },
        { "path": "", "label": "прихожая" },
        { "path": "docs/overview.html", "label": "обзор" }
      ],
      "quiet": ["**/*.md", "review/**", "mockups/**", ".claude/**", ".gitignore"]
    }
  ]
}
